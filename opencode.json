{
  "$schema": "https://opencode.ai/config.json",
  "compaction": { "auto": true, "tail_turns": 15 },
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "allow",
      "rm -rf *": "deny",
      "git push --force*": "deny",
      "git reset --hard*": "deny",
      "git clean -f*": "deny",
      "php artisan migrate:fresh*": "deny",
      "php artisan migrate:rollback*": "deny",
      "DROP DATABASE*": "deny"
    },
    "task": {
      "*": "allow",
      "analyst": "allow",
      "architect": "allow",
      "developer": "allow",
      "reviewer": "allow"
    },
    "todowrite": "allow"
  }
}